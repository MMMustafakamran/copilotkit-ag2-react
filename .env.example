# Names only. Copy the values into the files named below; never commit them.

# quickstart/.env (doc: `export OPENAI_API_KEY=...` and `export AUTH_SECRET=...`; start-all.sh passes it with --env-file)
OPENAI_API_KEY=
AUTH_SECRET=

# backend/.env (doc: `export OPENAI_API_KEY=...`)
# OPENAI_API_KEY=

# frontend/.env (doc: written by `npx copilotkit@latest project select`, read by the runtime route)
CPK_INTELLIGENCE_API_KEY=

